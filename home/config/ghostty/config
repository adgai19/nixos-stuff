# Ghostty configuration
#
# macOS + one Ghostty instance + tmux.
# Ghostty owns terminal/macOS integration; tmux owns persistent sessions,
# workspaces, panes and long-lived SSH connections.

# -----------------------------------------------------------------------------
# Appearance
# -----------------------------------------------------------------------------

theme = TokyoNight Storm

# Preserve the font size from the old configuration.
font-size = 9

# Keep the small padding you were using.
window-padding-x = 2
window-padding-y = 2

# -----------------------------------------------------------------------------
# macOS window behavior
# -----------------------------------------------------------------------------

# Native macOS decorations are important for normal window controls
# and native fullscreen.
window-decoration = true
macos-titlebar-style = hidden
macos-window-buttons = hidden
macos-non-native-fullscreen = true
macos-window-shadow = true

# tmux is the persistence/workspace layer.
window-save-state = never

# Preserve your existing Option-key behavior.
macos-option-as-alt = false

# Keep macOS Secure Input behavior enabled.
macos-auto-secure-input = true
macos-secure-input-indication = true

# -----------------------------------------------------------------------------
# Terminal behavior
# -----------------------------------------------------------------------------

window-vsync = true
scrollback-limit = 10000000

# Native Ghostty terminfo.
term = xterm-ghostty

# -----------------------------------------------------------------------------
# Clipboard / mouse
# -----------------------------------------------------------------------------

clipboard-read = ask
clipboard-write = allow
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true
copy-on-select = true

mouse-hide-while-typing = true
mouse-shift-capture = false
mouse-scroll-multiplier = 1

# -----------------------------------------------------------------------------
# Shell integration / SSH
# -----------------------------------------------------------------------------

shell-integration = detect

# Local shell integration + Ghostty's SSH integration.
shell-integration-features = cursor,title,ssh-env,ssh-terminfo

# -----------------------------------------------------------------------------
# Fullscreen
# -----------------------------------------------------------------------------

# New windows are not fullscreen by default.
fullscreen = false

# Your existing custom fullscreen shortcut.
keybind = ctrl+enter=toggle_fullscreen

# -----------------------------------------------------------------------------
# tmux owns the workspace
# -----------------------------------------------------------------------------
#
# No Ghostty pane/tab/workspace keybindings here.
#
# tmux owns:
#   - sessions
#   - workspaces
#   - panes
#   - persistent SSH connections
#   - long-running processes
#
# Ghostty owns:
#   - terminal rendering
#   - macOS window behavior
#   - clipboard
#   - shell/SSH integration
#   - fullscreen
#   - terminal-specific functionality